rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for private user account and onboarding data
    function isValidUser(data) {
      return data.id is string &&
             data.id == request.auth.uid &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 120 &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 100)) &&
             (!('college' in data) || (data.college is string && data.college.size() <= 120)) &&
             (!('course' in data) || (data.course is string && data.course.size() <= 100)) &&
             (!('year' in data) || (data.year is string && data.year.size() <= 60)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('learningMode' in data) || (data.learningMode is string && data.learningMode.size() <= 50)) &&
             (!('mode' in data) || data.mode in ['learner', 'mentor', 'both']) &&
             (!('skillsToLearn' in data) || data.skillsToLearn is list) &&
             (!('skillsToTeach' in data) || data.skillsToTeach is list) &&
             (!('careerGoals' in data) || (data.careerGoals is string && data.careerGoals.size() <= 1000)) &&
             (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 50)) &&
             (!('emailVerified' in data) || data.emailVerified is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for public student profile
    function isValidProfile(data) {
      return data.id is string &&
             data.id == request.auth.uid &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 120 &&
             data.fullName is string &&
             data.fullName.size() > 0 &&
             data.fullName.size() <= 100 &&
             (!('college' in data) || (data.college is string && data.college.size() <= 120)) &&
             (!('course' in data) || (data.course is string && data.course.size() <= 100)) &&
             (!('year' in data) || (data.year is string && data.year.size() <= 60)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('isOnboarded' in data) || data.isOnboarded is bool) &&
             (!('mode' in data) || data.mode in ['learner', 'mentor', 'both']) &&
             (!('learningMode' in data) || (data.learningMode is string && data.learningMode.size() <= 50)) &&
             (!('activeMode' in data) || data.activeMode in ['learner', 'mentor']);
    }

    // Validation for Lecture documents
    function isValidLecture(data) {
      return data.id is string &&
             data.teacherId is string &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             data.skill is string &&
             data.skill.size() <= 100 &&
             data.difficulty in ['Beginner', 'Intermediate', 'Advanced'] &&
             data.status in ['Draft', 'Upcoming', 'Live', 'Completed'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('duration' in data) || (data.duration is string && data.duration.size() <= 50)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('time' in data) || (data.time is string && data.time.size() <= 50)) &&
             (!('format' in data) || data.format in ['1-on-1', 'Small Group', 'Workshop']);
    }

    // Validation for Lecture Student enrollment documents
    function isValidLectureStudent(data) {
      return data.studentId is string &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.attendance in ['Present', 'Joined', 'Absent'] &&
             data.status in ['enrolled', 'active', 'completed'];
    }

    // Test connection document
    match /test/{testId} {
      allow get: if true;
    }

    // Private user accounts (PII, onboarding & sensitive authentication data)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // University Peer Profiles (viewable by authenticated peers, editable only by profile owner)
    match /profiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) && isValidProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Lectures
    match /lectures/{lectureId} {
      allow get: if isValidId(lectureId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(lectureId) && isSignedIn() && incoming().teacherId == request.auth.uid && isValidLecture(incoming());
      allow update: if isValidId(lectureId) && isSignedIn() && (
        (existing().teacherId == request.auth.uid && isValidLecture(incoming()) && incoming().teacherId == existing().teacherId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['studentsPresentCount', 'enrolledCount', 'status'])
      );
      allow delete: if isValidId(lectureId) && isSignedIn() && existing().teacherId == request.auth.uid;

      // Lecture Students subcollection
      match /students/{studentId} {
        allow get, list: if isValidId(lectureId) && isSignedIn();
        allow create, update: if isValidId(lectureId) && isValidId(studentId) && isSignedIn() && isValidLectureStudent(incoming());
        allow delete: if isValidId(lectureId) && isValidId(studentId) && isSignedIn() && (
          request.auth.uid == studentId ||
          request.auth.uid == get(/databases/$(database)/documents/lectures/$(lectureId)).data.teacherId
        );
      }
    }
  }
}
