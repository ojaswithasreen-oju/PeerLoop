{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private account credential, onboarding, and verification data.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name collected during onboarding."
        },
        "college": {
          "type": "string",
          "maxLength": 120,
          "description": "College or university."
        },
        "course": {
          "type": "string",
          "maxLength": 100,
          "description": "Degree or course of study."
        },
        "year": {
          "type": "string",
          "maxLength": 60,
          "description": "Academic year."
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Campus location or city."
        },
        "learningMode": {
          "type": "string",
          "enum": ["Learn", "Teach", "Learn + Teach"],
          "description": "Learning mode selected during onboarding."
        },
        "careerGoals": {
          "type": "string",
          "maxLength": 1000,
          "description": "Career or study goals."
        },
        "preferredLanguage": {
          "type": "string",
          "maxLength": 50,
          "description": "Preferred language for sessions."
        },
        "profileCompleted": {
          "type": "boolean",
          "description": "Whether onboarding flow was successfully completed."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user's email has been verified."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user account was last updated."
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student peer learning profile including skills, availability, and college info.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID matching the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "College or student email address."
        },
        "fullName": {
          "type": "string",
          "maxLength": 100,
          "description": "Full display name of the student."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "URL to student avatar image."
        },
        "college": {
          "type": "string",
          "maxLength": 120,
          "description": "University or college institution."
        },
        "course": {
          "type": "string",
          "maxLength": 100,
          "description": "Academic major or degree program."
        },
        "year": {
          "type": "string",
          "maxLength": 60,
          "description": "Academic year or graduation class."
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Campus location or city."
        },
        "bio": {
          "type": "string",
          "maxLength": 1000,
          "description": "Brief learning or mentoring bio."
        },
        "mode": {
          "type": "string",
          "enum": ["learner", "mentor", "both"],
          "description": "Primary role preference."
        },
        "activeMode": {
          "type": "string",
          "enum": ["learner", "mentor"],
          "description": "Active toggle mode in the application."
        },
        "isOnboarded": {
          "type": "boolean",
          "description": "Whether onboarding has been completed."
        },
        "profileCompleted": {
          "type": "boolean",
          "description": "Whether profile onboarding is completed."
        },
        "preferredLanguage": {
          "type": "string",
          "maxLength": 50,
          "description": "Preferred language for peer learning."
        },
        "learningFormat": {
          "type": "string",
          "maxLength": 100,
          "description": "Preferred study style or format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "email", "fullName", "createdAt"]
    },
    "Lecture": {
      "title": "Lecture",
      "description": "Lecture session created and managed by student teachers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Lecture unique identifier."
        },
        "teacherId": {
          "type": "string",
          "description": "Firebase Auth UID of the teacher."
        },
        "teacherName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the teacher."
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Lecture title."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Lecture description."
        },
        "skill": {
          "type": "string",
          "maxLength": 100,
          "description": "Skill or topic."
        },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "description": "Difficulty level."
        },
        "duration": {
          "type": "string",
          "maxLength": 50,
          "description": "Duration (e.g. 60 min)."
        },
        "date": {
          "type": "string",
          "maxLength": 50,
          "description": "Scheduled date."
        },
        "time": {
          "type": "string",
          "maxLength": 50,
          "description": "Scheduled time."
        },
        "format": {
          "type": "string",
          "enum": ["1-on-1", "Small Group", "Workshop"],
          "description": "Format of learning."
        },
        "maxStudents": {
          "type": "number",
          "description": "Maximum enrollment cap."
        },
        "status": {
          "type": "string",
          "enum": ["Draft", "Upcoming", "Live", "Completed"],
          "description": "Current lecture status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "teacherId", "title", "skill", "difficulty", "status", "createdAt"]
    },
    "LectureStudent": {
      "title": "LectureStudent",
      "description": "Student enrollment and attendance record in a lecture.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID."
        },
        "lectureId": {
          "type": "string",
          "description": "ID of the lecture."
        },
        "studentId": {
          "type": "string",
          "description": "Student Auth UID."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Student name."
        },
        "attendance": {
          "type": "string",
          "enum": ["Present", "Joined", "Absent"],
          "description": "Attendance status."
        },
        "status": {
          "type": "string",
          "enum": ["enrolled", "active", "completed"],
          "description": "Enrollment status."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when enrolled or joined."
        }
      },
      "required": ["id", "lectureId", "studentId", "name", "attendance", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account records and onboarding state restricted to the account owner."
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Student peer profiles visible to authenticated university peers."
    },
    "/lectures/{lectureId}": {
      "schema": "Lecture",
      "description": "Peer lectures hosted by student mentors and accessible to enrolled peers."
    },
    "/lectures/{lectureId}/students/{studentId}": {
      "schema": "LectureStudent",
      "description": "Enrollment and attendance subcollection for lectures."
    }
  }
}
